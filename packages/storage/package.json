{
  "name": "@flakemetry/storage",
  "version": "0.0.1",
  "description": "Object storage abstraction for test artifacts",
  "license": "MIT",
  "author": "Andrii Kohut",
  "homepage": "https://github.com/AKogut/flakemetry#readme",
  "bugs": "https://github.com/AKogut/flakemetry/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKogut/flakemetry.git",
    "directory": "packages/storage"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@flakemetry/eslint-config": "workspace:*",
    "@flakemetry/tsconfig": "workspace:*",
    "@flakemetry/tsup-config": "workspace:*",
    "@types/node": "^22.10.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@flakemetry/contracts": "workspace:*"
  },
  "private": true
}
