{
  "name": "@flakemetry/vitest-reporter",
  "version": "0.1.3",
  "description": "Vitest reporter emitting OpenTelemetry test spans to Flakemetry",
  "license": "MIT",
  "author": "Andrii Kohut",
  "homepage": "https://github.com/AKogut/flakemetry#readme",
  "bugs": "https://github.com/AKogut/flakemetry/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKogut/flakemetry.git",
    "directory": "packages/vitest-reporter"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@flakemetry/build-config": "workspace:*",
    "@flakemetry/eslint-config": "workspace:*",
    "@flakemetry/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@flakemetry/contracts": "workspace:*",
    "@flakemetry/sdk": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^1.6.0 || ^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0"
  }
}
