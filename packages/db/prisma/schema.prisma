generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TestStatus {
  pass
  fail
  skip
  flaky
}

enum RunStatus {
  running
  passed
  failed
  canceled
}

enum CiProvider {
  github_actions
  gitlab_ci
  circleci
  jenkins
  local
  other
}

enum RunTrigger {
  push
  pull_request
  schedule
  manual
  other
}

model Org {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  projects    Project[]
  memberships Membership[]
  invitations Invitation[]

  @@map("org")
}

enum MembershipRole {
  owner
  admin
  member
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  rcaFeedback      RcaFeedback[]
  policyChanges    PolicyChange[]
  identityChanges  IdentityChange[]

  @@map("user")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

/// The token is stored hashed and shown once, like an ingest token, because it is the same
/// kind of thing: whoever holds the link joins the workspace and can read every run, error
/// message and artifact in it. Short-lived and revocable for the same reason.
model Invitation {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  email      String
  role       MembershipRole @default(member)
  tokenHash  String         @unique @map("token_hash")
  invitedBy  String?        @map("invited_by") @db.Uuid
  expiresAt  DateTime       @map("expires_at")
  acceptedAt DateTime?      @map("accepted_at")
  acceptedBy String?        @map("accepted_by") @db.Uuid
  revokedAt  DateTime?      @map("revoked_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("invitation")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("membership")
}

model Project {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  slug          String
  defaultBranch String   @default("main") @map("default_branch")
  repository    String?
  badgeToken    String?  @unique @map("badge_token")
  codeowners    String?
  createdAt     DateTime @default(now()) @map("created_at")

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testIdentities  TestIdentity[]
  runs            Run[]
  executions      TestExecution[]
  flakyScores     FlakyScore[]
  errorSignatures ErrorSignature[]
  errorClusters   ErrorCluster[]
  rcaFeedback     RcaFeedback[]
  rcaReports      RcaReport[]
  ingestTokens    IngestToken[]
  ingestionJobs   IngestionJob[]
  policy          ProjectPolicy?
  policyChanges   PolicyChange[]
  dailyTestStats  DailyTestStats[]
  suiteDaily      SuiteDaily[]
  flakyTrends     FlakyTrends[]
  notificationChannels NotificationChannel[]
  healthEvents    TestHealthEvent[]
  identityStitches IdentityStitch[]
  identityMerges  IdentityMerge[]
  identityChanges IdentityChange[]
  trackerIssues   TrackerIssue[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("project")
}

model NotificationChannel {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  kind      String
  target    String
  secret    String?
  events    String[]
  enabled   Boolean  @default(true)
  source    String   @default("dashboard")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([orgId])
  @@map("notification_channel")
}

model ProjectPolicy {
  projectId              String   @id @map("project_id") @db.Uuid
  orgId                  String   @map("org_id") @db.Uuid
  flakyThreshold         Float?   @map("flaky_threshold")
  minSamples             Int?     @map("min_samples")
  quarantineEnabled      Boolean? @map("quarantine_enabled")
  quarantineCooldownRuns Int?     @map("quarantine_cooldown_runs")
  aiRcaEnabled           Boolean? @map("ai_rca_enabled")
  aiDailyTokenBudget     Int?     @map("ai_daily_token_budget")
  executionRetentionDays Int?     @map("execution_retention_days")
  artifactRetentionDays  Int?     @map("artifact_retention_days")
  ciMinuteCost           Float?   @map("ci_minute_cost")
  developerHourCost      Float?   @map("developer_hour_cost")
  investigationMinutes   Int?     @map("investigation_minutes")
  trackerEnabled         Boolean? @map("tracker_enabled")
  trackerAfterDays       Int?     @map("tracker_after_days")
  trackerRecoveryDays    Int?     @map("tracker_recovery_days")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("project_policy")
}

model PolicyChange {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([orgId])
  @@map("policy_change")
}

model IngestToken {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]  @default(["ingest"])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId])
  @@map("ingest_token")
}

enum IngestionJobStatus {
  pending
  processing
  done
  dead
}

model IngestionJob {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  projectId      String             @map("project_id") @db.Uuid
  idempotencyKey String             @map("idempotency_key")
  payload        Json
  status         IngestionJobStatus @default(pending)
  attempts       Int                @default(0)
  visibleAt      DateTime           @default(dbgenerated("now()")) @map("visible_at")
  lastError      String?            @map("last_error")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([status, visibleAt])
  @@index([orgId])
  @@map("ingestion_job")
}

enum QuarantineOverride {
  quarantined
  released
}

model TestIdentity {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  fingerprint      String
  filePath         String    @map("file_path")
  suite            String
  title            String
  paramsHash       String?   @map("params_hash")
  params           Json?
  aliases          String[]
  quarantined      Boolean   @default(false)
  quarantineReason String?   @map("quarantine_reason")

  /// Null means the scorer decides. Set, it means a person decided and the scorer must
  /// leave this test alone — in both directions, since releasing a still-flaky test is
  /// exactly as much a decision as quarantining a healthy one.
  quarantineOverride   QuarantineOverride? @map("quarantine_override")
  quarantineOverrideBy String?             @map("quarantine_override_by") @db.Uuid
  quarantineOverrideAt DateTime?           @map("quarantine_override_at")

  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions   TestExecution[]
  flakyScore   FlakyScore?
  dailyStats   DailyTestStats[]
  healthEvents TestHealthEvent[]
  stitches     IdentityStitch[]
  trackerIssue TrackerIssue?

  @@unique([projectId, fingerprint])
  @@index([orgId])
  @@index([projectId, lastSeenAt(sort: Desc)])
  @@index([projectId, suite, title])
  @@index([projectId, suite, title, paramsHash])
  @@index([projectId, filePath])
  @@index([aliases], type: Gin)
  @@map("test_identity")
}

model Run {
  id             String     @id @default(uuid()) @db.Uuid
  orgId          String     @map("org_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  idempotencyKey String     @map("idempotency_key")
  commitSha      String     @map("commit_sha")
  branch         String
  prNumber       Int?       @map("pr_number")
  ciProvider     CiProvider @map("ci_provider")
  ciRunId        String?    @map("ci_run_id")
  shardIndex     Int?       @map("shard_index")
  shardTotal     Int?       @map("shard_total")
  trigger        RunTrigger
  status         RunStatus
  startedAt      DateTime   @map("started_at")
  finishedAt     DateTime?  @map("finished_at")
  durationMs     Int?       @map("duration_ms")
  gitDiffStat    Json?      @map("git_diff_stat")
  otelTraceId    String?    @map("otel_trace_id")

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions TestExecution[]

  @@unique([projectId, idempotencyKey])
  @@index([orgId])
  @@index([projectId, startedAt(sort: Desc)])
  @@index([projectId, branch, startedAt(sort: Desc)])
  @@index([projectId, commitSha])
  @@index([projectId, ciRunId])
  @@map("run")
}

model TestExecution {
  id               String     @id @default(uuid()) @db.Uuid
  orgId            String     @map("org_id") @db.Uuid
  projectId        String     @map("project_id") @db.Uuid
  runId            String     @map("run_id") @db.Uuid
  testIdentityId   String     @map("test_identity_id") @db.Uuid
  mergedFromIdentityId String? @map("merged_from_identity_id") @db.Uuid
  ordinal          Int?
  attempt          Int        @default(1)
  retryOf          String?    @map("retry_of") @db.Uuid
  status           TestStatus
  durationMs       Int        @map("duration_ms")
  errorMessage     String?    @map("error_message")
  errorSignatureId String?    @map("error_signature_id") @db.Uuid
  otelTraceId      String?    @map("otel_trace_id")
  otelSpanId       String?    @map("otel_span_id")
  artifactsRef     Json?      @map("artifacts_ref")
  attributes       Json?
  spans            Json?
  startedAt        DateTime   @map("started_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  identity       TestIdentity    @relation(fields: [testIdentityId], references: [id], onDelete: Cascade)
  errorSignature ErrorSignature? @relation(fields: [errorSignatureId], references: [id], onDelete: SetNull)
  rcaReport      RcaReport?

  @@unique([runId, ordinal])
  @@index([orgId])
  @@index([runId])
  @@index([testIdentityId, startedAt(sort: Desc)])
  @@index([projectId, startedAt(sort: Desc)])
  @@index([errorSignatureId])
  @@index([mergedFromIdentityId])
  @@map("test_execution")
}

model FlakyScore {
  testIdentityId      String    @id @map("test_identity_id") @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  score               Float
  flipRate            Float     @map("flip_rate")
  passOnRerunRate     Float     @map("pass_on_rerun_rate")
  sameShaVariance     Float     @map("same_sha_variance")
  entropy             Float
  failIsolation       Float     @map("fail_isolation")
  reasonCodes         Json      @map("reason_codes")
  quarantineCandidate Boolean   @default(false) @map("quarantine_candidate")
  lastFlakedAt        DateTime? @map("last_flaked_at")
  modelVersion        String    @map("model_version")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identity TestIdentity @relation(fields: [testIdentityId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, score(sort: Desc)])
  @@map("flaky_score")
}

model ErrorCluster {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  label           String
  knownIssueRef   String?  @map("known_issue_ref")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signatures ErrorSignature[]

  @@index([orgId])
  @@index([projectId, lastSeenAt(sort: Desc)])
  @@map("error_cluster")
}

model ErrorSignature {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  normalizedHash  String   @map("normalized_hash")
  sampleMessage   String   @map("sample_message")
  stackTemplate   String   @map("stack_template")
  clusterId       String?  @map("cluster_id") @db.Uuid
  tokens          String[] @default([])
  occurrenceCount Int      @default(1) @map("occurrence_count")
  knownIssueRef   String?  @map("known_issue_ref")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cluster    ErrorCluster?   @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  executions TestExecution[]
  rcaReports RcaReport[]

  @@unique([projectId, normalizedHash])
  @@index([orgId])
  @@index([projectId, lastSeenAt(sort: Desc)])
  @@index([projectId, clusterId])
  @@map("error_signature")
}

model RcaReport {
  id              String   @id @default(uuid()) @db.Uuid
  promptVersion   String   @default("v1") @map("prompt_version")
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  executionId     String   @unique @map("execution_id") @db.Uuid
  signatureId     String   @map("signature_id") @db.Uuid
  summary         String
  likelyCause     String   @map("likely_cause")
  suggestedAction String   @map("suggested_action")
  confidence      Float
  similarPast     Json     @map("similar_past")
  llmModel        String   @map("llm_model")
  tokenCost       Int      @map("token_cost")
  createdAt       DateTime @default(now()) @map("created_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution TestExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  signature ErrorSignature @relation(fields: [signatureId], references: [id], onDelete: Cascade)
  feedback  RcaFeedback[]

  @@index([orgId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([signatureId])
  @@map("rca_report")
}

enum RcaVerdict {
  helpful
  unhelpful
}

model RcaFeedback {
  id         String     @id @default(uuid()) @db.Uuid
  orgId      String     @map("org_id") @db.Uuid
  projectId  String     @map("project_id") @db.Uuid
  reportId   String     @map("report_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  verdict    RcaVerdict
  correction String?
  createdAt  DateTime   @default(now()) @map("created_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report  RcaReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([orgId])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("rca_feedback")
}

model DailyTestStats {
  projectId      String   @map("project_id") @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  testIdentityId String   @map("test_identity_id") @db.Uuid
  day            DateTime @db.Date
  total          Int      @default(0)
  passed         Int      @default(0)
  failed         Int      @default(0)
  flaky          Int      @default(0)
  skipped        Int      @default(0)
  avgDurationMs  Int      @default(0) @map("avg_duration_ms")
  rerunCount     Int      @default(0) @map("rerun_count")
  rerunMs        Int      @default(0) @map("rerun_ms")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identity TestIdentity @relation(fields: [testIdentityId], references: [id], onDelete: Cascade)

  @@id([testIdentityId, day])
  @@index([projectId, day])
  @@map("daily_test_stats")
}

model SuiteDaily {
  projectId     String   @map("project_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  suite         String
  day           DateTime @db.Date
  total         Int      @default(0)
  passed        Int      @default(0)
  failed        Int      @default(0)
  flaky         Int      @default(0)
  skipped       Int      @default(0)
  avgDurationMs Int      @default(0) @map("avg_duration_ms")
  rerunCount    Int      @default(0) @map("rerun_count")
  rerunMs       Int      @default(0) @map("rerun_ms")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, suite, day])
  @@index([projectId, day])
  @@map("suite_daily")
}

model FlakyTrends {
  projectId        String   @map("project_id") @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  day              DateTime @db.Date
  flakyCount       Int      @default(0) @map("flaky_count")
  quarantinedCount Int      @default(0) @map("quarantined_count")
  avgScore         Float    @default(0) @map("avg_score")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, day])
  @@map("flaky_trends")
}

model TestHealthEvent {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  testIdentityId String   @map("test_identity_id") @db.Uuid
  kind           String
  score          Float?
  mergedFromIdentityId String? @map("merged_from_identity_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identity TestIdentity @relation(fields: [testIdentityId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([testIdentityId, createdAt])
  @@index([orgId])
  @@map("test_health_event")
}

model IdentityStitch {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  testIdentityId  String   @map("test_identity_id") @db.Uuid
  level           String
  fromFingerprint String   @map("from_fingerprint")
  fromFilePath    String?  @map("from_file_path")
  fromTitle       String?  @map("from_title")
  toFilePath      String    @map("to_file_path")
  toTitle         String    @map("to_title")
  confidence      Float?
  runStartedAt    DateTime? @map("run_started_at")
  mergedFromIdentityId String? @map("merged_from_identity_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identity TestIdentity @relation(fields: [testIdentityId], references: [id], onDelete: Cascade)

  @@index([testIdentityId, createdAt])
  @@index([projectId, createdAt])
  @@index([orgId])
  @@map("identity_stitch")
}

model IdentityChange {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  action           String
  sourceIdentityId String   @map("source_identity_id") @db.Uuid
  targetIdentityId String?  @map("target_identity_id") @db.Uuid
  fingerprint      String
  detail           String?
  createdAt        DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([orgId])
  @@map("identity_change")
}

model IdentityMerge {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  targetIdentityId  String    @map("target_identity_id") @db.Uuid
  sourceIdentityId  String    @map("source_identity_id") @db.Uuid
  sourceFingerprint String    @map("source_fingerprint")
  sourceFilePath    String    @map("source_file_path")
  sourceSuite       String    @map("source_suite")
  sourceTitle       String    @map("source_title")
  sourceParamsHash  String?   @map("source_params_hash")
  sourceParams      Json?     @map("source_params")
  sourceAliases     String[]  @map("source_aliases")
  sourceFirstSeenAt DateTime  @map("source_first_seen_at")
  sourceLastSeenAt  DateTime  @map("source_last_seen_at")
  undoneAt          DateTime? @map("undone_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([targetIdentityId, createdAt(sort: Desc)])
  @@index([orgId])
  @@map("identity_merge")
}

enum DataRequestKind {
  export
  erasure
}

enum DataRequestStatus {
  pending
  running
  completed
  failed
}

/// Deliberately without a relation to org or project: this row is the evidence that a
/// tenant was erased, so a cascade from that tenant would delete the proof along with the
/// data. `subject` and `artifactPrefix` are captured at request time for the same reason —
/// once the erasure runs there is nothing left to join against.
model DataRequest {
  id             String            @id @default(uuid()) @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  projectId      String?           @map("project_id") @db.Uuid
  kind           DataRequestKind
  status         DataRequestStatus @default(pending)
  subject        String
  actor          String
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  artifactPrefix String            @map("artifact_prefix")
  rowCount       Int?              @map("row_count")
  artifactCount  Int?              @map("artifact_count")
  residue        Json?
  error          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")

  @@index([status, createdAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("data_request")
}

model TrackerIssue {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  testIdentityId String    @unique @map("test_identity_id") @db.Uuid
  provider       String    @default("github")
  externalId     String    @map("external_id")
  url            String
  state          String    @default("open")
  lastScore      Float?    @map("last_score")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  lastSyncedAt   DateTime  @default(now()) @map("last_synced_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identity TestIdentity @relation(fields: [testIdentityId], references: [id], onDelete: Cascade)

  @@index([projectId, state])
  @@index([orgId])
  @@map("tracker_issue")
}
