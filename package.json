{
  "name": "flakemetry",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @flakemetry/db db:generate",
    "db:migrate": "pnpm --filter @flakemetry/db db:migrate",
    "db:reset": "pnpm --filter @flakemetry/db db:reset",
    "db:seed": "pnpm --filter @flakemetry/db db:seed",
    "demo": "pnpm --filter @flakemetry/db db:seed:force",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "docker compose down -v && docker compose up -d --build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "tsdown": "0.23.0",
    "turbo": "^2.11.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.5",
      "find-my-way": "^9.7.0",
      "fast-json-stringify>fast-uri": "^4.2.1",
      "ajv>fast-uri": "^3.1.8",
      "brace-expansion": "^2.1.7",
      "@fastify/ajv-compiler>fast-uri": "^3.1.8",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "@prisma/config>deepmerge-ts": "^8.0.0",
      "mysql2@<3.22.0": "^3.22.0",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
