{
  "name": "flakemetry",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @flakemetry/db db:generate",
    "db:migrate": "pnpm --filter @flakemetry/db db:migrate",
    "db:reset": "pnpm --filter @flakemetry/db db:reset",
    "db:seed": "pnpm --filter @flakemetry/db db:seed",
    "demo": "pnpm --filter @flakemetry/db db:seed:force",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "docker compose down -v && docker compose up -d --build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "turbo": "^2.10.8",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "find-my-way": "^9.7.0",
      "fast-json-stringify>fast-uri": "^4.1.1",
      "ajv>fast-uri": "^3.1.4",
      "brace-expansion": "^2.0.2",
      "@fastify/ajv-compiler>fast-uri": "^3.1.4"
    }
  }
}
