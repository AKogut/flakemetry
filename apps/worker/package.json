{
  "name": "@flakemetry/worker",
  "version": "0.0.3",
  "private": true,
  "description": "Processing workers: identity, scoring, clustering, RCA",
  "type": "module",
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo",
    "start": "node dist/index.js",
    "test": "vitest run",
    "restitch": "tsx src/restitch.ts",
    "eval": "tsx src/eval.ts"
  },
  "devDependencies": {
    "@flakemetry/api": "workspace:*",
    "@flakemetry/build-config": "workspace:*",
    "@flakemetry/eslint-config": "workspace:*",
    "@flakemetry/queries": "workspace:*",
    "@flakemetry/sdk": "workspace:*",
    "@flakemetry/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@flakemetry/ai": "workspace:*",
    "@flakemetry/contracts": "workspace:*",
    "@flakemetry/core": "workspace:*",
    "@flakemetry/db": "workspace:*",
    "@flakemetry/notify": "workspace:*",
    "@flakemetry/plugin-host": "workspace:*",
    "@flakemetry/queries": "workspace:*",
    "@flakemetry/storage": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0"
  }
}
