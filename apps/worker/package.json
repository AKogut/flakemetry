    "@flakemetry/tsup-config": "workspace:*",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "vitest": "^4.1.10",
    "@flakemetry/queries": "workspace:*",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@flakemetry/ai": "workspace:*",
    "@flakemetry/contracts": "workspace:*",
    "@flakemetry/core": "workspace:*",
    "@flakemetry/db": "workspace:*",
    "@flakemetry/notify": "workspace:*",
    "@flakemetry/queries": "workspace:*",
    "@flakemetry/storage": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0"
  }
