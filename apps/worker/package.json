{
  "name": "@flakemetry/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Processing workers: identity, scoring, clustering, RCA",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
