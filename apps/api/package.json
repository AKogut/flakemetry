{
  "name": "@flakemetry/api",
  "version": "0.0.5",
  "private": true,
  "description": "Ingestion and query API service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@flakemetry/build-config": "workspace:*",
    "@flakemetry/eslint-config": "workspace:*",
    "@flakemetry/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@flakemetry/contracts": "workspace:*",
    "@flakemetry/db": "workspace:*",
    "@flakemetry/plugin-host": "workspace:*",
    "@flakemetry/queries": "workspace:*",
    "@flakemetry/storage": "workspace:*",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@trpc/server": "^11.26.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  }
}
