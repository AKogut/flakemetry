POSTGRES_USER=flakemetry
POSTGRES_PASSWORD=flakemetry
POSTGRES_DB=flakemetry
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flakemetry:flakemetry@localhost:5432/flakemetry?schema=public
MINIO_ROOT_USER=flakemetry
MINIO_ROOT_PASSWORD=flakemetry123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=flakemetry-artifacts
API_PORT=4000
WEB_PORT=3000

# Artifact storage (screenshots/video/trace). The reporter asks the API for a
# presigned upload URL and pushes files straight to the object store; the
# dashboard serves them back via time-limited signed URLs. Unset the bucket to
# turn the artifact pipeline off. docker-compose wires these to the bundled
# MinIO automatically; set them explicitly to point at real S3.
#   FLAKEMETRY_S3_PUBLIC_ENDPOINT: browser-reachable host for download URLs
#   FLAKEMETRY_ARTIFACT_RETENTION_DAYS: worker prunes objects older than this
FLAKEMETRY_S3_PUBLIC_ENDPOINT=http://localhost:9000
# Kept at least as long as executions that reference them (the worker raises it
# to the execution horizon if you set it lower) so no execution points at a
# pruned object.
FLAKEMETRY_ARTIFACT_RETENTION_DAYS=90

# Trend rollups are materialized on ingest, so raw executions can be kept short
# while daily/suite/flaky aggregates persist. The worker prunes raw executions
# older than this; unset keeps every execution (rollups are unaffected either way).
FLAKEMETRY_EXECUTION_RETENTION_DAYS=90

AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

# Instance-wide scoring policy override. Highest precedence: overrides both the
# per-project policy set in the dashboard and the built-in defaults. Leave unset
# to let the dashboard (or defaults) decide. Applies to every project.
FLAKEMETRY_FLAKY_THRESHOLD=
FLAKEMETRY_FLAKY_MIN_SAMPLES=
FLAKEMETRY_QUARANTINE_ENABLED=
FLAKEMETRY_QUARANTINE_COOLDOWN_RUNS=
FLAKEMETRY_AI_RCA=

# AI root-cause analysis. Off unless a provider is configured. The worker sends
# only new (deduplicated) error signatures to the model, scrubbed of secrets and
# PII, and stops for the day once the token budget is spent.
#   FLAKEMETRY_AI_PROVIDER: 'claude' | 'ollama' (defaults to claude when a key is set)
#   FLAKEMETRY_AI_MODEL:    model id (claude-opus-5 by default; e.g. llama3.1 for ollama)
FLAKEMETRY_AI_PROVIDER=
FLAKEMETRY_AI_MODEL=
FLAKEMETRY_AI_API_KEY=
ANTHROPIC_API_KEY=
FLAKEMETRY_AI_ENDPOINT=
FLAKEMETRY_AI_DAILY_TOKEN_BUDGET=200000
# Hard timeout for a single LLM call (ms). RCA is best-effort: on timeout the
# analysis is skipped, never failing the ingest job. Default 30000.
FLAKEMETRY_AI_TIMEOUT_MS=

# Queue visibility timeout (ms): how long a picked-up job is hidden before it
# can be re-delivered. Set comfortably above worst-case processing time to avoid
# duplicate processing / false dead-lettering. Default 300000 (5 min).
FLAKEMETRY_QUEUE_VISIBILITY_MS=
