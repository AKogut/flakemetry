POSTGRES_USER=flakemetry
POSTGRES_PASSWORD=flakemetry
POSTGRES_DB=flakemetry
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flakemetry:flakemetry@localhost:5432/flakemetry?schema=public
MINIO_ROOT_USER=flakemetry
MINIO_ROOT_PASSWORD=flakemetry123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=flakemetry-artifacts
API_PORT=4000
WEB_PORT=3000

AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

# Instance-wide scoring policy override. Highest precedence: overrides both the
# per-project policy set in the dashboard and the built-in defaults. Leave unset
# to let the dashboard (or defaults) decide. Applies to every project.
FLAKEMETRY_FLAKY_THRESHOLD=
FLAKEMETRY_FLAKY_MIN_SAMPLES=
FLAKEMETRY_QUARANTINE_ENABLED=
FLAKEMETRY_QUARANTINE_COOLDOWN_RUNS=
FLAKEMETRY_AI_RCA=

# AI root-cause analysis. Off unless a provider is configured. The worker sends
# only new (deduplicated) error signatures to the model, scrubbed of secrets and
# PII, and stops for the day once the token budget is spent.
#   FLAKEMETRY_AI_PROVIDER: 'claude' | 'ollama' (defaults to claude when a key is set)
#   FLAKEMETRY_AI_MODEL:    model id (claude-opus-5 by default; e.g. llama3.1 for ollama)
FLAKEMETRY_AI_PROVIDER=
FLAKEMETRY_AI_MODEL=
FLAKEMETRY_AI_API_KEY=
ANTHROPIC_API_KEY=
FLAKEMETRY_AI_ENDPOINT=
FLAKEMETRY_AI_DAILY_TOKEN_BUDGET=200000
