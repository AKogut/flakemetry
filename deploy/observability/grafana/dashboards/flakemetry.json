          "expr": "histogram_quantile(0.99, sum by (le) (rate(flakemetry_http_server_duration_milliseconds_bucket{job=\"flakemetry-api\",route=~\"/v1/ingest.*|/v1/traces\"}[5m])))",
          "legendFormat": "p99",
          "refId": "B",
          "range": true
