# Copy to deploy/compose/.env and fill in. Nothing here has a working default on purpose —
# a production stack that starts with the quickstart's password is worse than one that
# refuses to start.

# --- Hostnames. All three need an A record pointing at this machine before you start. ---
WEB_DOMAIN=flakemetry.example.com
API_DOMAIN=api.flakemetry.example.com
ARTIFACTS_DOMAIN=artifacts.flakemetry.example.com

# --- Secrets. Generate, do not invent. ---
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=
MINIO_ROOT_USER=flakemetry
# openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# --- GitHub OAuth app ---
# Homepage:      https://flakemetry.example.com
# Callback URL:  https://flakemetry.example.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Retention. Set these on day one; unset means keep everything forever. ---
FLAKEMETRY_EXECUTION_RETENTION_DAYS=90
FLAKEMETRY_ARTIFACT_RETENTION_DAYS=30

# --- Optional: AI root-cause analysis ---
# FLAKEMETRY_AI_RCA=true
# FLAKEMETRY_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# FLAKEMETRY_AI_MODEL=claude-sonnet-5
# A hard daily ceiling. Without it a pathological run can spend without bound.
# FLAKEMETRY_AI_DAILY_TOKEN_BUDGET=200000

# --- Optional: file GitHub issues for persistent flakes ---
# A fine-grained PAT with Issues:write on the target repository, nothing else.
# The project's "repository" field must also be set on its Policy page, or the tracker
# has nowhere to file.
# FLAKEMETRY_TRACKER_ENABLED=true
# FLAKEMETRY_TRACKER_TOKEN=
# FLAKEMETRY_TRACKER_AFTER_DAYS=3
# FLAKEMETRY_TRACKER_RECOVERY_DAYS=7

# --- Optional: cost reporting ---
# FLAKEMETRY_CI_MINUTE_COST=0.008
# FLAKEMETRY_DEVELOPER_HOUR_COST=60
# FLAKEMETRY_INVESTIGATION_MINUTES=20
